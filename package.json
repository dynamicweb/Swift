{
  "name": "dynamicweb-swift",
  "version": "2.5.0",
  "description": "Dynamicweb Swift is a plug-and-play standard solution which allows you to create beautiful mobile-friendly websites",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint _src/js",
    "lint:css": "stylelint \"_src/scss/**/*.scss\""
  },
  "author": "Dynamicweb Software A/S",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "browserslist": "4.29.5",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "lightningcss": "1.33.0",
    "sass": "1.101.0",
    "stylelint": "17.16.0",
    "stylelint-config-recommended-scss": "17.0.1"
  },
  "dependencies": {
    "alpinejs": "3.15.12",
    "bootstrap": "5.3.8",
    "flatpickr": "4.6.13",
    "htmx.org": "2.0.10",
    "swiffy-slider": "2.1.1"
  },
  "browserslist": [
    "defaults",
    "iOS >= 15",
    "Safari >= 15"
  ]
}
