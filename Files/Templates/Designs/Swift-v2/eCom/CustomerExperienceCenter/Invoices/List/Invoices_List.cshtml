@inherits Dynamicweb.Rendering.ViewModelTemplate<Dynamicweb.Ecommerce.Frontend.Invoices.BcInvoiceListViewModel>
@using System
@using System.Globalization
@using Dynamicweb.Core.Encoders
@using Dynamicweb.Ecommerce.CustomerExperienceCenter.Invoices
@using Dynamicweb.Ecommerce.Frontend.Invoices
@using Dynamicweb.Frontend
@using Dynamicweb.Rendering

@{
    string baseUrl = SearchEngineFriendlyURLs.GetFriendlyUrl($"default.aspx?ID={Pageview.Page.ID}");

    // The module serves invoices and credit memos through this one template; DocumentType is the only signal.
    bool isCreditMemo = Model.DocumentType == BcDocumentType.CreditMemo;

    // Raw BC statuses. "Overdue" is derived for display only and has no backend filter, so offering it
    // as a filter would return nothing.
    var statuses = new[] { Translate("Open"), Translate("Paid"), Translate("Canceled") };

    // The backend normalises the sort direction, so read it from the model rather than the query string.
    string arrow = Model.SortDescending
        ? ReadFile("/Files/Images/Icons/arrow-down.svg")
        : ReadFile("/Files/Images/Icons/arrow-up.svg");

    string filterStatus = Model.FilterStatus ?? string.Empty;
    string filterDateFrom = Model.FilterDateFrom?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) ?? string.Empty;
    string filterDateTo = Model.FilterDateTo?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) ?? string.Empty;

    int activeFilterCount =
        (string.IsNullOrEmpty(filterStatus) ? 0 : 1) +
        (string.IsNullOrEmpty(filterDateFrom) ? 0 : 1) +
        (string.IsNullOrEmpty(filterDateTo) ? 0 : 1);
}

<header class="hstack gap-3 mb-4">
    <div>
        <h1 class="h4 mb-0">@(Pageview.Page.GetDisplayName())</h1>
    </div>
</header>

@if (Model.AccountSummary is not null)
{
    <div class="card mb-3">
        <div class="card-body p-3">
            @if (!string.IsNullOrEmpty(Model.AccountSummary.BlockedReason))
            {
                <div class="alert alert-warning fs-7 py-2 px-3">
                    <span class="fw-bold">@Translate("Your account is blocked")</span>
                    <span>@(Model.AccountSummary.BlockedReason)</span>
                </div>
            }
            <div class="grid grid-2 grid-lg-4 gap-3 fs-7">
                @if (!string.IsNullOrEmpty(Model.AccountSummary.CustomerNumber))
                {
                    <div>
                        <small class="text-muted">@Translate("Customer number")</small>
                        <div>@(Model.AccountSummary.CustomerNumber)</div>
                    </div>
                }
                @* BC returns these in its own local currency, not the currency of any one document. *@
                <div>
                    <small class="text-muted">@Translate("Balance")</small>
                    <div class="text-price">@(Model.AccountSummary.Balance)</div>
                </div>
                <div>
                    <small class="text-muted">@Translate("Balance due")</small>
                    <div class="text-price @(Model.AccountSummary.HasOverdueBalance ? "text-danger" : null)">@(Model.AccountSummary.BalanceDue)</div>
                </div>
                @if (Model.AccountSummary.CreditLimit > 0)
                {
                    <div>
                        <small class="text-muted">@Translate("Credit limit")</small>
                        <div class="text-price">@(Model.AccountSummary.CreditLimit)</div>
                    </div>
                }
            </div>
        </div>
    </div>
}

<form hx-get="@(baseUrl)"
    hx-trigger="submit,
                change,
                input from:input[name='Search'] changed delay:500ms queue:last,
                click from:button[type='reset']"
    hx-sync="this:abort"
    hx-swap="outerHTML"
    hx-disinherit="*"
    hx-target="[data-swift-bc-invoice-list]"
    hx-select="[data-swift-bc-invoice-list]"
    hx-replace-url="true"
    hx-on:click="const sortInput = event.target.closest('label')?.querySelector('input[name=SortBy]');
                 if (!sortInput) return;
                 const sortDescField = this.querySelector('[name=SortDesc]');
                 if (!sortDescField) return;
                 if (sortInput.checked) {
                     sortDescField.value = sortDescField.value === '1' ? '0' : '1';
                     this.requestSubmit();
                 } else {
                     sortDescField.value = '0';
                 }">

    @* Search and filter live outside [data-swift-bc-invoice-list] so the caret position and the open
       dropdown survive every swap. *@
    <nav class="hstack gap-2 mb-3">
        <div class="flex-fill">
            <div class="input-group">
                <span class="input-group-text border-end-0 bg-body">
                    <span class="htmx-indicator spinner-border spinner-border-sm" aria-hidden="true"></span>
                    <span class="icon-2" data-swift-indicator-origin>@ReadFile("/Files/Images/Icons/magnifying-glass.svg")</span>
                </span>
                @* The backend matches the document number only, so the placeholder promises nothing more. *@
                <input type="search" class="form-control border-start-0 border-end-0" name="Search" value="@HtmlEncoder.HtmlAttributeEncode(Model.SearchText ?? string.Empty)" placeholder="@Translate(isCreditMemo ? "Search credit memo number" : "Search invoice number")...">
                <button type="reset" class="input-group-text border-start-0 bg-body" onclick="this.closest('form').querySelector('[name=Search]').value = ''; this.closest('form').dispatchEvent(new Event('change', { bubbles: true }))">
                    <span class="icon-2">@ReadFile("/Files/Images/Icons/xmark.svg")</span>
                    <span class="visually-hidden">@Translate("Clear search")</span>
                </button>
            </div>
        </div>
        <div class="dropdown hstack">
            @* auto-close outside, or clicking into a date field closes the menu. *@
            <button class="btn btn-sm btn-outline-secondary hstack gap-2 ms-auto py-2 px-3 text-body" data-dw-button type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                <span class="icon-2">
                    @ReadFile("/Files/Images/Icons/filter.svg")
                </span>
                @Translate("Filter")
                @if (activeFilterCount > 0)
                {
                    <span class="badge lh-sm badge-neutral-dark">@(activeFilterCount)</span>
                }
            </button>
            <div class="dropdown-menu p-3" style="min-width: 22rem;">
                <div class="fw-bold mb-1">@Translate("Status")</div>
                <div class="d-flex flex-wrap gap-2 mb-3" role="group" aria-label="@Translate("Filter by status")">
                    <input class="btn-check" type="radio" name="FilterStatus" value="" id="bcStatus_all" autocomplete="off" checked="@(filterStatus == string.Empty)">
                    <label for="bcStatus_all" class="fs-8 py-1 px-2 btn btn-outline-secondary text-body lh-1" data-dw-button>@Translate("All")</label>
                    @foreach (var status in statuses)
                    {
                        <input class="btn-check" type="radio" name="FilterStatus" value="@(status)" id="bcStatus_@(status)" autocomplete="off" checked="@(filterStatus == status)">
                        <label for="bcStatus_@(status)" class="fs-8 py-1 px-2 btn btn-outline-secondary text-body lh-1" data-dw-button>@Translate(status)</label>
                    }
                </div>
                <div class="grid grid-2 gap-2">
                    <div>
                        <label class="form-label fs-8 mb-1" for="bcDateFrom">@Translate("Date from")</label>
                        <input type="date" class="form-control form-control-sm" id="bcDateFrom" name="FilterDateFrom" value="@(filterDateFrom)">
                    </div>
                    <div>
                        <label class="form-label fs-8 mb-1" for="bcDateTo">@Translate("Date to")</label>
                        <input type="date" class="form-control form-control-sm" id="bcDateTo" name="FilterDateTo" value="@(filterDateTo)">
                    </div>
                </div>
            </div>
        </div>
    </nav>

    <div data-swift-bc-invoice-list>
        @* Always rendered: the backend reads an absent SortDesc as descending and any non-"1" value as
           ascending, so leaving it out would flip the direction. *@
        <input type="hidden" name="SortDesc" value="@(Model.SortDescending ? "1" : "0")">
        @if (isCreditMemo)
        {
            <input type="hidden" name="DocType" value="CreditMemo">
        }
        @* No hidden PageNum: a submitter's value is only sent on submit, so searching, filtering or
           sorting omits it and the backend falls back to page 1. *@

        <div class="card overflow-hidden">
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>
                                <label class="hstack gap-1" role="button">
                                    <input type="radio" name="SortBy" value="Number" class="visually-hidden" checked="@(Model.SortBy == BcInvoiceSortField.Number)" />
                                    @Translate("Number")
                                    @if (Model.SortBy == BcInvoiceSortField.Number)
                                    {
                                        <span class="icon-1">@(arrow)</span>
                                    }
                                </label>
                            </th>
                            <th>
                                <label class="hstack gap-1" role="button">
                                    <input type="radio" name="SortBy" value="InvoiceDate" class="visually-hidden" checked="@(Model.SortBy == BcInvoiceSortField.InvoiceDate)" />
                                    @Translate("Placed")
                                    @if (Model.SortBy == BcInvoiceSortField.InvoiceDate)
                                    {
                                        <span class="icon-1">@(arrow)</span>
                                    }
                                </label>
                            </th>
                            <th>
                                <label class="hstack gap-1" role="button">
                                    <input type="radio" name="SortBy" value="DueDate" class="visually-hidden" checked="@(Model.SortBy == BcInvoiceSortField.DueDate)" />
                                    @Translate("Due date")
                                    @if (Model.SortBy == BcInvoiceSortField.DueDate)
                                    {
                                        <span class="icon-1">@(arrow)</span>
                                    }
                                </label>
                            </th>
                            @* Status is not a member of BcInvoiceSortField, so this column stays unsortable. *@
                            <th>@Translate("Status")</th>
                            <th>
                                <label class="hstack gap-1" role="button">
                                    <input type="radio" name="SortBy" value="Amount" class="visually-hidden" checked="@(Model.SortBy == BcInvoiceSortField.Amount)" />
                                    @Translate("Total")
                                    @if (Model.SortBy == BcInvoiceSortField.Amount)
                                    {
                                        <span class="icon-1">@(arrow)</span>
                                    }
                                </label>
                            </th>
                            <th>@Translate("Actions")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var document in Model.Documents)
                        {
                            // "Overdue" is derived for display only - BC has no such status.
                            string status = string.Equals(document.Status, "Open", StringComparison.OrdinalIgnoreCase)
                                && document.DueDate != default
                                && document.DueDate.Date < DateTime.Today
                                    ? "Overdue"
                                    : document.Status;

                            string statusColor = status?.ToLowerInvariant() switch
                            {
                                "paid" => "var(--bs-success)",
                                "open" => "var(--bs-warning)",
                                "overdue" => "var(--bs-danger)",
                                "canceled" => "var(--bs-secondary)",
                                _ => null
                            };

                            <tr class="position-relative">
                                <td>
                                    @if (!string.IsNullOrEmpty(document.DetailLink))
                                    {
                                        <a class="stretched-link text-decoration-none text-decoration-underline-hover" href="@(document.DetailLink)">@(document.Number)</a>
                                    }
                                    else
                                    {
                                        @(document.Number)
                                    }
                                </td>
                                <td>@(document.InvoiceDate.ToString("d", Pageview.Area.CultureInfo))</td>
                                <td>@(document.DueDate.ToString("d", Pageview.Area.CultureInfo))</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(status))
                                    {
                                        <span class="badge lh-sm badge-neutral-light" style="@(statusColor is not null ? $"background-color: color-mix(in srgb, {statusColor} 20%, transparent) !important; color: {statusColor} !important" : null)">@Translate(status)</span>
                                    }
                                </td>
                                <td><span class="text-price">@(document.Total.Price?.Formatted)</span></td>
                                <td>
                                    <button class="btn btn-icon position-relative z-2" data-dw-button type="button" data-bs-toggle="dropdown" aria-expanded="false" data-bs-popper-config='{"strategy":"fixed", "placement":"bottom-end"}'>
                                        <span class="icon-2">
                                            @ReadFile("/Files/Images/Icons/ellipsis.svg")
                                        </span>
                                    </button>
                                    <ul class="dropdown-menu">
                                        @if (!string.IsNullOrEmpty(document.DetailLink))
                                        {
                                            <li>
                                                <a class="dropdown-item hstack gap-2 ps-2 pe-3 rounded-1" href="@(document.DetailLink)">
                                                    <span class="icon-2">
                                                        @ReadFile("/Files/Images/Icons/eye.svg")
                                                    </span>
                                                    @Translate("View")
                                                </a>
                                            </li>
                                        }
                                        @if (!string.IsNullOrEmpty(document.DownloadLink))
                                        {
                                            @* New tab on purpose: a document with no PDF in BC answers 404,
                                               which would otherwise replace the Customer Center page. *@
                                            <li>
                                                <a class="dropdown-item hstack gap-2 ps-2 pe-3 rounded-1" href="@(document.DownloadLink)" target="_blank" rel="noopener">
                                                    <span class="icon-2">
                                                        @ReadFile("/Files/Images/Icons/download.svg")
                                                    </span>
                                                    @Translate("Download PDF")
                                                </a>
                                            </li>
                                        }
                                    </ul>
                                </td>
                            </tr>
                        }

                        @* A failed BC call must not look like an empty result set - without this branch
                           "nothing here" and "we could not reach Business Central" render identically. *@
                        @if (Model.HasError)
                        {
                            <tr class="position-relative">
                                <td class="text-center py-5" colspan="6">
                                    <div data-swift-empty-state>
                                        <div data-swift-empty-state-icon>
                                            <span class="icon">
                                                @ReadFile("/Files/Images/Icons/triangle-exclamation.svg")
                                            </span>
                                        </div>
                                        <div>@Translate("We could not load your invoices right now")</div>
                                    </div>
                                </td>
                            </tr>
                        }
                        else if (Model.Documents.Count < 1)
                        {
                            <tr class="position-relative">
                                <td class="text-center py-5" colspan="6">
                                    <div data-swift-empty-state>
                                        <div data-swift-empty-state-icon>
                                            <span class="icon">
                                                @ReadFile("/Files/Images/Icons/file-contract.svg")
                                            </span>
                                        </div>
                                        <div>@Translate(isCreditMemo ? "No credit memos found" : "No invoices found")</div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (Model.PageCount > 1)
        {
            <div class="hstack justify-content-between mt-3">
                <div class="text-muted fs-7">
                    @Translate("Showing page") @(Model.CurrentPage) @Translate("of") @(Model.PageCount)
                </div>

                <div class="hstack gap-2">
                    <button type="submit" class="btn btn-outline-secondary text-body hstack p-2" name="PageNum" value="@(Model.CurrentPage - 1)" data-dw-button disabled="@(Model.CurrentPage == 1)">
                        <span class="icon-2">
                            @ReadFile("/Files/Images/Icons/chevron-left.svg")
                        </span>
                    </button>
                    <button type="submit" class="btn btn-outline-secondary text-body hstack p-2" name="PageNum" value="@(Model.CurrentPage + 1)" data-dw-button disabled="@(Model.CurrentPage == Model.PageCount)">
                        <span class="icon-2">
                            @ReadFile("/Files/Images/Icons/chevron-right.svg")
                        </span>
                    </button>
                </div>
            </div>
        }

        @* Editor only: RequestUri is the raw BC endpoint and ResponseBody the raw payload - neither
           belongs in page source on a live site. *@
        @if (Pageview.IsVisualEditorMode && Model.HasError)
        {
            <details class="card mt-3 fs-8">
                <summary class="card-body py-2 px-3 text-muted" role="button">@Translate("Business Central request diagnostics")</summary>
                <div class="card-body pt-0">
                    @* The document list and the account summary are separate BC requests, so each
                       failure carries its own URI and payload. *@
                    @foreach (var error in Model.Errors)
                    {
                        <div class="alert alert-warning py-2 px-3">
                            <div class="fw-bold">HTTP @(error.StatusCode)</div>
                            @if (error.RequestUri is not null)
                            {
                                <div><code class="text-break">@(error.RequestUri)</code></div>
                            }
                            <div>@(error.Message)</div>
                            @if (!string.IsNullOrEmpty(error.ResponseBody))
                            {
                                <pre class="mb-0 mt-2" style="white-space: pre-wrap; max-height: 20rem; overflow-y: auto;">@HtmlEncoder.HtmlEncode(error.ResponseBody)</pre>
                            }
                        </div>
                    }
                </div>
            </details>
        }
    </div>
</form>
