@inherits ViewModelTemplate<UserGroupUserListViewModel>
@using Dynamicweb.Rendering
@using Dynamicweb.Users.Frontend.UserGroups

@*
    One modal per user list. A Delete button in the list opens it with data-bs-toggle="modal" and carries
    the user's name (data-swift-user-name) and the delete command URL (data-swift-delete-url).
    The Delete button below gets that URL as its hx-post, so it runs the same command the list used to run directly.
*@

@{
    string modalId = $"deleteUserModal_{Pageview?.CurrentParagraph?.ID}";
}

<div class="modal fade" id="@(modalId)" tabindex="-1" aria-labelledby="@(modalId)_title" aria-hidden="true"
    x-data
    x-on:show-bs-modal.dot="
        const trigger = $event.relatedTarget;
        if (!trigger) return;
        $refs.userName.textContent = trigger.dataset.swiftUserName ?? '';
        $refs.deleteButton.setAttribute('hx-post', trigger.dataset.swiftDeleteUrl ?? '');
        htmx.process($refs.deleteButton);
    "
    x-on:hide-bs-modal.dot="
        const el = document.activeElement;
        if (el && $el.contains(el)) el.blur();
    ">
    <div class="modal-dialog pt-8">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="@(modalId)_title">@Translate("Delete user")</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Translate("Cancel")"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted mb-0">@Translate("Are you sure you want to delete the user") <span class="fw-bold text-body" x-ref="userName"></span>?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal" data-dw-button>@Translate("Cancel")</button>
                <button type="button" class="btn btn-primary btn-sm" data-dw-button data-bs-dismiss="modal"
                    x-ref="deleteButton"
                    hx-disinherit="*"
                    hx-target="[data-swift-user-list]"
                    hx-select="[data-swift-user-list]"
                    hx-swap="outerHTML"
                    hx-push-url="false">
                    @Translate("Delete")
                </button>
            </div>
        </div>
    </div>
</div>
