@inherits ViewModelTemplate<UserGroupUserListViewModel>
@using Dynamicweb.Rendering
@using Dynamicweb.Users.Frontend.UserGroups

@{
    string? toastText = Model?.ResultType switch
    {
        UserGroupResultType.UserActiveStateChanged => Translate("The user status has been changed"),
        UserGroupResultType.InvitationResent => Translate("An invitation has been resent"),
        UserGroupResultType.UserDeleted => Translate("The user has been deleted"),
        UserGroupResultType.UserInviteSuccess => Translate("The user has been invited"),
        UserGroupResultType.SaveGroupSuccess => Translate("The account has been saved"),
        _ => null
    };
}

@if (toastText is not null)
{
    @RenderPartial("/Designs/Swift-v2/Components/Toast.cshtml", Model, new Dictionary<string, object>
    {
        { "Title", toastText },
        { "State", "success" }
    })
}
