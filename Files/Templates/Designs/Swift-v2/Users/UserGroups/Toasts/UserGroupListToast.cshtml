@inherits ViewModelTemplate<UserGroupListViewModel>
@using Dynamicweb.Rendering
@using Dynamicweb.Users.Frontend.UserGroups

@{
    var isError = Model?.Result == UserGroupResultType.IncorrectPermission;
    string? toastText = Model?.Result switch
    {
        UserGroupResultType.SaveGroupSuccess => Translate("The account has been saved"),
        UserGroupResultType.IncorrectPermission => Translate("You do not have permission to edit this account"),
        _ => null
    };
}

@if (toastText is not null)
{
    @RenderPartial("/Designs/Swift-v2/Components/Toast.cshtml", Model, new Dictionary<string, object>
    {
        { "Title", toastText },
        { "State", isError ? "danger" : "success" }
    })
}
