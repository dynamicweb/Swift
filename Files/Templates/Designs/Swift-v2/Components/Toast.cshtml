@inherits Dynamicweb.Rendering.ViewModelTemplate<Dynamicweb.Rendering.ViewModelBase>
@using Dynamicweb.Core.Encoders

@* One toast, mounted into a shared region by swift.Toast.Show.
   View parameters: Title (required), Text, State ("success" or "danger"), Image (url), Placement ("top" or "bottom"), Delay (ms). *@

@{
    var title = GetViewParameterString("Title");
    if (string.IsNullOrEmpty(title))
    {
        return;
    }

    var text = GetViewParameterString("Text");
    var image = GetViewParameterString("Image");
    var isSuccess = GetViewParameterString("State") != "danger";
    var accent = isSuccess ? "success" : "danger";
    var iconPath = isSuccess ? "/Files/Images/Icons/check.svg" : "/Files/Images/Icons/triangle-exclamation.svg";
    var placement = GetViewParameterString("Placement") == "top" ? "top" : "bottom";
    var role = isSuccess ? "status" : "alert";
    var live = isSuccess ? "polite" : "assertive";

    var delay = GetViewParameterInt32("Delay");
    if (delay <= 0)
    {
        delay = 5000;
    }
}

<div class="toast bg-body" role="@(role)" aria-live="@(live)" aria-atomic="true" data-dw-colorscheme="light" style="--swift-toast-duration: @(delay)ms;" x-data x-init="swift.Toast.Show($el, { placement: '@(placement)', delay: @(delay) })">
    <div class="hstack">
        <div class="toast-body hstack gap-2 border-start border-4 border-@(accent) align-items-center">
            @if (!string.IsNullOrEmpty(image))
            {
                <span class="d-flex img-thumbnail bg-white" style="aspect-ratio: 1;">
                    <img class="img-fluid mh-100 m-auto" src="@(image)" alt="">
                </span>
            }
            else
            {
                <span class="d-grid p-2 rounded-2" style="background-color: color-mix(in srgb, var(--bs-@(accent)) 10%, transparent);">
                    <span class="icon text-@(accent)">@ReadFile(iconPath)</span>
                </span>
            }
            <div class="vstack justify-content-center lh-sm">
                <span>@(HtmlEncoder.HtmlEncode(title))</span>
                @if (!string.IsNullOrEmpty(text))
                {
                    <span class="fs-8">@(HtmlEncoder.HtmlEncode(text))</span>
                }
            </div>
        </div>
        <button type="button" class="btn-close fs-8 me-3 m-auto" data-bs-dismiss="toast" aria-label="@(HtmlEncoder.HtmlEncode(Translate("Close")))"></button>
    </div>
    <div class="toast-progress bg-@(accent)-subtle" aria-hidden="true"></div>
</div>
