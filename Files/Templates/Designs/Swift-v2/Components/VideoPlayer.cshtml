@inherits Dynamicweb.Rendering.ViewModelTemplate<Dynamicweb.Frontend.VideoViewModel>
@using System.IO;
@using Dynamicweb.Frontend
@using Dynamicweb.Core.Encoders
@using System.Text.RegularExpressions

@if(!string.IsNullOrEmpty(Model.Path)) 
{		
	<swift-video-player itemscope itemtype="https://schema.org/VideoObject">
		<figure class="m-0 ratio ratio-16x9">
			<meta itemprop="name" content="@GetViewParameterString("VideoName")" />
			<meta itemprop="description" content="@GetViewParameterString("VideoDescription")" />
			<meta itemprop="contentUrl" content="@Model.Path" />
			
			@if (!string.IsNullOrEmpty(Model.Thumbnail))
			{
				<meta itemprop="thumbnailUrl" content="@Model.Thumbnail" />
			}

			@if (Model.IsExternalLink())
			{
				// Embed without tracking cookies: YouTube from youtube-nocookie.com, Vimeo with dnt=1
				string embedUrl = Model.ToEmbedUrl()?.ToString();
				Match youtubeId = Regex.Match(Model.Path, @"(?:youtube(?:-nocookie)?\.com/(?:.*[?&]v=|embed/|shorts/|live/)|youtu\.be/)([\w-]{11})", RegexOptions.IgnoreCase);
				if (youtubeId.Success)
				{
					embedUrl = $"https://www.youtube-nocookie.com/embed/{youtubeId.Groups[1].Value}";
				}
				else if (embedUrl?.Contains("player.vimeo.com", StringComparison.OrdinalIgnoreCase) == true)
				{
					embedUrl += (embedUrl.Contains('?') ? "&" : "?") + "dnt=1";
				}

				<iframe src="@HtmlEncoder.HtmlEncode(embedUrl)"title="@GetViewParameterString("VideoName")" frameborder="0" allow="fullscreen; picture-in-picture; autoplay; clipboard-write; encrypted-media; web-share"></iframe>
			}
			else
			{
				<video preload="auto" data-swift-video poster="@Model.Thumbnail">
					<source src="@Model.Path" type="@Model.GetVideoType()">
				</video>
				<button type="button" aria-label="@Translate("Play/Pause video")" data-swift-video-play-btn></button>
			}
		</figure>
	</swift-video-player>
}
