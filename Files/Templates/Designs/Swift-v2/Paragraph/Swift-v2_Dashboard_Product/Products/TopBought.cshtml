@inherits ViewModelTemplate<PurchasedProductListViewModel>
@using Dynamicweb.Core.Encoders
@using Dynamicweb.Ecommerce.ProductCatalog
@using Dynamicweb.Frontend
@using Dynamicweb.Rendering

@{
    string cartUrl = "/Default.aspx?ID=" + GetPageIdByNavigationTag("CartService");
    if (!cartUrl.Contains("LayoutTemplate"))
    {
        cartUrl += cartUrl.Contains("?") ? "&LayoutTemplate=Swift-v2_MiniCart.cshtml" : "?LayoutTemplate=Swift-v2_MiniCart.cshtml";
    }
}

@if (!(Model.PurchasedProducts?.Any() ?? false))
{
    <div class="d-grid align-items-center text-center fs-7 fw-semibold gap-2">
        <div class="d-grid rounded-circle m-auto" style="aspect-ratio:1;background-color:rgba(var(--bs-body-color-rgb), .0275);">
            <span class="icon fs-5 text-muted p-3">
                @ReadFile("/Files/Images/Icons/cube.svg")
            </span>
        </div>
        <div>@Translate("No products found")</div>
    </div>
    return;
}

<div class="list-group list-group-flush">
    @{
        var counter = 0;
    }
    @foreach (var topProduct in Model.PurchasedProducts)
    {
        counter++;

        var product = topProduct.Product;
        var trackStock = product?.ProductType == Dynamicweb.Ecommerce.Products.ProductType.Stock && !(product?.NeverOutOfstock ?? false);
        var disableAddToCart = string.IsNullOrEmpty(product?.Id) || product?.Discontinued == true || (trackStock && product?.StockLevel <= 0) ? "disabled" : null;
        double? stepQty = (product?.PurchaseQuantityStep ?? 0) > 0 ? product?.PurchaseQuantityStep : 1;
        double? minQty = (product?.PurchaseMinimumQuantity ?? 0) > 0 ? product?.PurchaseMinimumQuantity : 1;
        double? maxQty = trackStock ? product?.StockLevel : null;
        double? quantity = minQty > stepQty ? minQty : stepQty;

        <form method="post" action="@cartUrl" class="list-group-item px-0 py-3 hstack flex-wrap gap-2 gap-sm-3" x-data>
            <input type="hidden" name="redirect" value="false">
            <input type="hidden" name="ProductId" value="@product?.Id">
            <input type="hidden" name="ProductName" value="@HtmlEncoder.HtmlEncode(product?.Name)">
            <input type="hidden" name="ProductVariantName" value="@HtmlEncoder.HtmlEncode(product?.VariantName)">
            <input type="hidden" name="ProductCurrency" value="@(Dynamicweb.Ecommerce.Common.Context.Currency.Code)">
            <input type="hidden" name="ProductPrice" value="@(product?.Price?.PriceFormatted)">
            <input type="hidden" name="ProductReferer" value="customer_center_top_bought">
            <input type="hidden" name="cartcmd" value="add">
            <input type="submit" class="d-none" onclick="event.preventDefault(); swift.Cart.Update(event)">

            @if (!string.IsNullOrEmpty(product?.VariantId))
            {
                <input type="hidden" name="VariantId" value="@product?.VariantId">
            }

            <template class="js-step-quantity-warning">
                <div class="modal-header">
                    <h5 class="modal-title">@Translate("The quantity is not valid")</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Translate("Close")"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted">@Translate("Please select a quantity that is dividable by") @stepQty</p>
                </div>
            </template>

            <template class="js-min-quantity-warning">
                <div class="modal-header">
                    <h5 class="modal-title">@Translate("The product could not be added to the cart")</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Translate("Close")"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted">@Translate("The quantity is not valid. You must buy at least") @minQty</p>
                </div>
            </template>

            <template class="js-value-missing-warning">
                <div class="modal-header">
                    <h5 class="modal-title">@Translate("No amount specified")</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Translate("Close")"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted">@Translate("Specify an amount to add to the cart")</p>
                </div>
            </template>

            <div class="text-muted fs-7" style="inline-size: 1.5rem;">@(counter).</div>

            @if (product?.DefaultImage?.TryGetImageFileViewModel(out var image) is true)
            {
                <div class="d-flex img-thumbnail" style="inline-size: 40px; aspect-ratio: 1;">
                    <img class="m-auto" src="@(image?.ToGetImage(new(){Height = 32, Width = 32, Ratio = "1/1", Crop = Dynamicweb.Imaging.ImageHandling.CropMode.KeepAspectRatio }))" alt="@HtmlEncoder.HtmlEncode(product?.Name)">
                </div>
            }
            else
            {
                <div class="d-flex img-thumbnail" style="inline-size: 40px; aspect-ratio: 1;">
                    <span class="icon-2 m-auto text-muted">@ReadFile("/Files/Images/Icons/cube.svg")</span>
                </div>
            }

            <div class="vstack min-w-0">
                <div class="fs-7 fw-semibold text-body text-truncate">@HtmlEncoder.HtmlEncode(product?.Name)</div>
                @if (product?.VariantId != null)
                {
                    <div class="fs-8 text-truncate">@HtmlEncoder.HtmlEncode(product?.VariantName)</div>
                }
                <div class="fs-8 text-muted text-truncate">
                    @HtmlEncoder.HtmlEncode(product?.Number)
                    <span>· @(topProduct.OrderCount) @(topProduct.OrderCount == 1 ? Translate("order") : Translate("orders"))</span>
                </div>
            </div>
            
            <div class="d-grid align-items-center gap-2" style="grid-template-columns: 1fr 90px 1fr auto;">
                <div class="d-grid position-relative" style="grid-template-columns: 1fr auto 1fr;">
                    <input id="TopBoughtQuantity_@(counter)" name="Quantity" value="@(quantity)" step="@(stepQty)" min="@(minQty)" max="@(maxQty)" class="form-control fs-8 border-0 rounded-0 px-1 text-center" type="number" inputmode="numeric" data-qty @disableAddToCart placeholder="0" tabindex="0">
                    <span class="visually-hidden">@Translate("Type a number, or use the decrease or increase button to change the quantity")</span>

                    <button type="button" data-qty-step="decrease" aria-label="@Translate("The button to decrease the quantity")" class="btn btn-icon fs-8 order-first" data-dw-button onclick="this.parentNode.querySelector('[data-qty]').stepDown()" @disableAddToCart tabindex="-1">
                        <span class="icon">@ReadFile("/Files/Images/Icons/minus.svg")</span>
                    </button>

                    <button type="button" data-qty-step="increase" aria-label="@Translate("The button to increase the quantity")" class="btn btn-icon fs-8 order-last" data-dw-button onclick="this.parentNode.querySelector('[data-qty]').stepUp()" @disableAddToCart tabindex="-1">
                        <span class="icon">@ReadFile("/Files/Images/Icons/plus.svg")</span>
                    </button>

                    <span class="position-absolute border pe-none" data-dw-button style="inset: 0; border-radius: var(--dw-btn-border-radius);"></span>
                </div>

                @if (product?.UnitOptions?.Count > 0)
                {
                    <select name="UnitID" class="form-select fs-8 w-auto" x-on:change="$refs.price.textContent = $el.selectedOptions[0].dataset.price" @disableAddToCart>
                        @foreach (var unitOption in product.UnitOptions)
                        {
                            var unitPriceFormatted = unitOption.Price?.PriceFormatted;
                            <option value="@(unitOption.Id)" selected="@(unitOption.Id == product.DefaultUnitId)" data-price="@HtmlEncoder.HtmlEncode(unitPriceFormatted ?? product.Price?.PriceFormatted)">
                                @HtmlEncoder.HtmlEncode(string.IsNullOrEmpty(unitPriceFormatted) ? unitOption.Name : unitOption.Name + " – " + unitPriceFormatted)
                            </option>
                        }
                    </select>
                }
                else if (!string.IsNullOrEmpty(product?.DefaultUnitId))
                {
                    <input type="hidden" name="UnitID" value="@product.DefaultUnitId">
                    <span class="fs-8 text-center text-muted">@(product?.UnitOptions?.FirstOrDefault(u => u.Id == product.DefaultUnitId)?.Name ?? Translate("Piece"))</span>
                }
                else 
                {
                    <span class="fs-8 text-center text-muted">@(Translate("Piece"))</span>
                }

                <div class="text-price fs-7 fw-semibold text-end" x-ref="price">
                    @(product?.Price?.PriceFormatted)
                </div>

                <button type="button" onclick="swift.Cart.Update(event)" class="btn btn-outline-secondary fs-8 p-2 text-reset align-self-auto hstack gap-2 @disableAddToCart" @disableAddToCart data-dw-button>
                    <span class="icon fs-8">@ReadFile("/Files/Images/Icons/cart-shopping.svg")</span>
                    <span>@Translate("Add to cart")</span>
                </button>
            </div>
        </form>
    }
</div>
